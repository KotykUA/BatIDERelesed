# ══════════════════════════════════════════════════════════════════════
#  BatIDE — .gitignore
# ══════════════════════════════════════════════════════════════════════
#  Rule: ignore DIRECTORIES, not extensions. Broad globs like *.dll / *.exe
#  silently break future project resources (plugin DLLs, embedded tools).
#  All real build output lives under bin/, obj/ or publish/, so those three
#  lines cover everything.
# ══════════════════════════════════════════════════════════════════════

# ── .NET / MSBuild build outputs ──────────────────────────────────────
bin/
obj/
artifacts/
*.binlog
*.tlog

# ── `dotnet publish` output ───────────────────────────────────────────
# Matches publish/win-x64/, publish/linux-x64/, publish/osx-arm64/, …
publish/

# ── NuGet ─────────────────────────────────────────────────────────────
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json

# ── Avalonia codegen ──────────────────────────────────────────────────
.avalonia/
*.axaml.g.cs

# ── JetBrains Rider / IntelliJ ────────────────────────────────────────
# Entirely ignored. Rider re-creates .idea/ on first open.
.idea/

# ── Visual Studio / VS Code ───────────────────────────────────────────
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# ── ReSharper ─────────────────────────────────────────────────────────
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
*.sln.iml

# ── Logs & crash dumps ────────────────────────────────────────────────
*.log
*.dmp
*.dump

# ── OS junk ───────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Signing & secrets (never commit) ──────────────────────────────────
*.pfx
*.snk
*.publishsettings
*.pubxml.user
.env
.env.*
!.env.example
secrets.json
