<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BatIDE</RootNamespace>
    <AssemblyName>BatIDE</AssemblyName>
    <ApplicationIcon>LOGO3.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <Configurations>Debug;Release</Configurations>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Зовнішні залежності (DLL-ки), які раніше підключалися з абсолютних шляхів
    на машині автора (C:\Users\Vlad\...). Тепер вони очікуються у папці ..\libs\
    Поклади туди:
      - AutocompleteMenu.dll
      - FastColoredTextBox.dll
    (Див. libs\README.md)
  -->
  <ItemGroup>
    <Reference Include="FastColoredTextBox">
      <HintPath>..\libs\FastColoredTextBox.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    Пакети, потрібні для .NET 8:
      * System.CodeDom                     — для `using System.CodeDom.Compiler;` у BatEditor.cs
      * System.Configuration.ConfigurationManager — для Settings1 / ApplicationSettingsBase
      * Fody + Costura.Fody                — вшивання DLL в один exe (як було раніше)
  -->
  <ItemGroup>
    <PackageReference Include="System.CodeDom" Version="8.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="Fody" Version="6.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Costura.Fody" Version="5.7.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
